# 复制为 ops-desk/api/.env（已 gitignore，勿提交密钥）
# 与文档站共用同一资源桶时可只改 PREFIX；密钥沿用腾讯云同一对 Secret。

OPS_DESK_STORAGE=cos
OPS_DESK_COS_SECRET_ID=your_secret_id
OPS_DESK_COS_SECRET_KEY=your_secret_key
OPS_DESK_COS_BUCKET=trinity-ai-resources-1430233363
OPS_DESK_COS_REGION=ap-singapore

# 运营台专用根前缀（控制台可见为「文件夹」trinity-Ops-Desk）
OPS_DESK_COS_PREFIX=trinity-Ops-Desk/

# 对外访问（可选；不填则用 https://{bucket}.cos.{region}.myqcloud.com/{key}）
# OPS_DESK_COS_PUBLIC_BASE=https://trinity-ai-resources-1430233363.cos.ap-singapore.myqcloud.com

# 约定子目录（对象键前缀，COS 无真实文件夹，上传即「建目录」）：
#   trinity-Ops-Desk/contracts/{customer_id}/   客户合同
#   trinity-Ops-Desk/payments/{YYYY-MM}/        付款申请导出
#   trinity-Ops-Desk/settlement-confirm/        云服务确认单 PDF
#   trinity-Ops-Desk/invoices/                  开票相关附件
#   trinity-Ops-Desk/templates/                 样板同步（可选）
